# Plantilla de .env para producción (GCP) — copiar a .env en el servidor y
# completar los valores marcados. Es igual a la raíz .env.example salvo lo
# que efectivamente cambia entre local y producción (marcado con "PROD:" en
# el comentario). El resto de las integraciones opcionales quedan con la
# misma explicación de siempre — la app funciona sin completarlas, solo esa
# función puntual queda oculta/desactivada.
#
#   cp deploy/.env.production.example .env
#   nano .env   # completar todo lo marcado [COMPLETAR]
#   php artisan key:generate

APP_NAME=Arka01
# PROD: nunca "local" ni "true" en el servidor real — activa el modo debug
# (expone stack traces con datos internos) y desactiva el CSP de
# App\Http\Middleware\SecurityHeaders (que a propósito solo se aplica fuera
# de local).
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# PROD: dominio real, con HTTPS.
APP_URL=https://arka01.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Guayaquil

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# PROD: no hace falta el detalle de "debug" en los logs del servidor real.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arka01
DB_USERNAME=arka01
# [COMPLETAR] password fuerte y propia — la que usaste al crear el usuario
# de MySQL en el paso 2 de deploy/README.md. Nunca reusar la de otro entorno.
DB_PASSWORD=

BROADCAST_CONNECTION=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
# PROD: cookies de sesión solo por HTTPS (ya estamos detrás de Certbot).
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# [COMPLETAR] credenciales SMTP reales — en local esto apunta a mailpit, que
# no existe en producción. Sin esto, no salen correos (bienvenida,
# recuperar contraseña). Cualquier proveedor sirve (el propio Gmail con una
# "contraseña de aplicación", SendGrid, Mailgun, etc.).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="soporte@arka01.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# No se usa (Arka01 usa Reverb, no Pusher) — queda vacío a propósito.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"

# Reverb (WebSockets "en vivo"): dos pares de variables con roles distintos
# — no confundirlas.
# - REVERB_SERVER_* es donde el PROCESO `php artisan reverb:start` escucha
#   DE VERDAD en el servidor: siempre localhost, nunca expuesto directo (lo
#   expone Nginx por HTTPS/WSS — ver deploy/nginx-arka01.conf).
# - REVERB_HOST/PORT/SCHEME es la dirección PÚBLICA a la que el navegador
#   (y el propio backend, al publicar un evento) se conectan — el dominio
#   real, puerto 443, https.
# [COMPLETAR] REVERB_APP_ID/KEY/SECRET: strings random propios (ej.
# `openssl rand -hex 20`), nunca vacíos ni reusados de otro entorno.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=arka01.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Mismos valores que arriba, "horneados" en el JS compilado (Vite los
# necesita en BUILD TIME, no solo en runtime) — por eso hay que correr
# `npm run build` recién DESPUÉS de completar estas variables.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Push notifications (WebPush/VAPID) — opcional, se puede dejar para
# después. Generar con: php artisan webpush:vapid
VAPID_SUBJECT="mailto:soporte@arka01.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Login con Google — opcional, el botón "Continuar con Google" queda oculto
# solo mientras esto esté vacío. [COMPLETAR] si lo vas a usar: actualizar
# también la "URI de redirección autorizados" en Google Cloud Console al
# dominio real.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://arka01.com/auth/google/callback

# Verificación de teléfono por WhatsApp (Meta Business) — opcional, sin
# esto el registro no exige verificar el teléfono (queda auto-verificado,
# no rompe nada). Ver .env.example (raíz) para el paso a paso completo.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_NUMBER=
WHATSAPP_VERIFICATION_TEMPLATE=arka01_verificacion
BASE_URL=
API_VERSION=
WHATSAPP_TYPING_INDICATOR=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# [COMPLETAR antes de un piloto con gente real] Firma del webhook — sin
# esto, el webhook de WhatsApp acepta mensajes sin validar que vengan
# realmente de Meta (ver App\Http\Middleware\VerifyWhatsAppSignature). Meta
# for Developers > tu app > Configuración > Básica > "App Secret".
WHATSAPP_APP_SECRET=

# Autocompletado de direcciones (Google Places API) — opcional, sin esto
# los campos de dirección quedan como texto libre normal.
VITE_GOOGLE_MAPS_API_KEY=

# Monitoreo de errores (Sentry) — opcional, completamente desactivado
# mientras esto quede vacío. Un proyecto gratis en sentry.io alcanza para
# un piloto.
SENTRY_LARAVEL_DSN=
