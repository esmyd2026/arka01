APP_NAME=Arka01
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Guayaquil

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arka01
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
# Pedido explícito del usuario: la sesión no debe cerrarse sola por
# inactividad (segundo plano, pantalla bloqueada, etc.) — solo con "Cerrar
# sesión". 30 días en vez de las 2 horas por defecto de Laravel.
SESSION_LIFETIME=43200

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="soporte@arka01.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SERVER_PORT=
REVERB_SCHEME=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Login con Google — completar con las credenciales de un proyecto OAuth de
# Google Cloud Console (console.cloud.google.com > APIs y servicios >
# Credenciales > ID de cliente de OAuth > tipo "Aplicación web"). En
# "URI de redirección autorizados" agregar exactamente la misma URL que
# GOOGLE_REDIRECT_URI. Mientras estas variables estén vacías, el botón
# "Continuar con Google" queda oculto solo (sin romper nada).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
#GOOLE_PLACE_API_NEW=AIzaSyDMpB7jUMLqQROOIewg8lhAOe1_2e_0gFg

# Verificación de teléfono por WhatsApp — completar con las credenciales de
# Meta Business Manager (business.facebook.com > WhatsApp > Configuración de
# la API): WHATSAPP_TOKEN es el token de acceso permanente del sistema,
# WHATSAPP_PHONE_NUMBER_ID el "Phone number ID" del número emisor. Además hay
# que crear y esperar la aprobación de una plantilla de mensaje con un único
# parámetro de texto en el cuerpo (ej. "Tu código de verificación de Arka01
# es {{1}}"), con el mismo nombre que WHATSAPP_VERIFICATION_TEMPLATE.
# Mientras estas variables estén vacías, el registro no exige verificar el
# teléfono (queda verificado automáticamente, sin romper nada).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_NUMBER=
WHATSAPP_VERIFICATION_TEMPLATE=arka01_verificacion
BASE_URL=
API_VERSION=
WHATSAPP_TYPING_INDICATOR=

# Ventana de 24h para avisos por WhatsApp (ver App\Http\Controllers\WhatsAppWebhookController
# y App\Services\WhatsAppFreeformSender) — WHATSAPP_BUSINESS_NUMBER es tu
# número oficial en dígitos (mismo valor que WHATSAPP_PHONE_NUMBER de arriba),
# usado para el link "wa.me" del botón "Conectar WhatsApp". WHATSAPP_WEBHOOK_VERIFY_TOKEN
# es el mismo string que pusiste en "Identificador de verificación" en Meta.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Firma del webhook (auditoría de seguridad, pedido explícito del usuario):
# sin esto, cualquiera que conozca la URL del webhook puede mandar mensajes
# falsos como si fueran de Meta. Completar con el "App Secret" de Meta for
# Developers > tu app > Configuración > Básica. Mientras quede vacío, el
# webhook sigue funcionando SIN validar la firma (igual que hoy) — no rompe
# nada, pero conviene completarlo antes de producción.
WHATSAPP_APP_SECRET=

# Autocompletado de direcciones (Google Places API "New") — completar con tu
# API key (ver .env.example para el paso a paso). Vacío = campos de texto
# libre normales, sin sugerencias.
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Motor de despacho explicable. false restaura el orden tradicional por
# cercanía sin cambiar código ni afectar las selecciones manuales.
SMART_DISPATCH_ENABLED=true
