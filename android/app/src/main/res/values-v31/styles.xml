<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) reemplaza el splash clásico (drawable/splash,
    ver values/styles.xml) por su propia Splash Screen API — sin este
    override queda con el fondo gris por defecto del sistema en vez del
    color de marca, aunque el ícono ya salga bien (lo deriva solo del
    ic_launcher adaptativo). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
